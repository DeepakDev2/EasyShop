# ─── SERVER ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ─── DATABASE (Neon PostgreSQL) ───────────────────────────
DATABASE_URL=postgresql://user:password@ep-xxxxx.neon.tech/easyshopdb?sslmode=require

# ─── AUTH ─────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-at-least-256-bits
JWT_EXPIRES_IN=24h

# ─── EMAIL (Nodemailer) ───────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=EasyShop <noreply@easyshop.com>

# ─── FILE UPLOADS ─────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# ─── CLIENT ───────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_APP_NAME=EasyShop
